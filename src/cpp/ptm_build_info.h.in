// ptm_build_info.h -- GENERATED by cmake/GenerateBuildInfo.cmake. Do not edit.
//
// The engine's own identity, compiled in so that a finished run can say which
// binary produced it. Before this existed, `metadata.txt` was the only thing
// the engine wrote about a run and it recorded no version, no commit and no
// checksum, so provenance had to be reconstructed by hand from build logs.
//
// DELIBERATELY ABSENT: a build timestamp. Anything that changes on every
// rebuild changes the executable's md5 on every rebuild, and this project
// identifies binaries by md5. The identity here is a pure function of the
// source tree and the configure options, so two builds of the same commit with
// the same options produce the same bytes.
//
// PTM_BUILD_GIT_SHA is resolved at BUILD time, not configure time, and the
// generator rewrites this header only when the value actually changes -- so a
// commit made between builds is picked up, and a no-op rebuild does not
// relink.

#ifndef PTM_BUILD_INFO_H
#define PTM_BUILD_INFO_H

#define PTM_BUILD_VERSION      "@PTM_VERSION@"
#define PTM_BUILD_GIT_SHA      "@PTM_GIT_SHA@"
#define PTM_BUILD_TYPE         "@PTM_BUILD_TYPE@"
#define PTM_BUILD_GPU          "@PTM_GPU_LABEL@"
#define PTM_BUILD_COMPILER     "@PTM_COMPILER@"
// "true" when the project libraries are shared: then the executable's md5 is
// no longer a complete identity for the engine, because a change confined to
// one library would not move it.
#define PTM_BUILD_SHARED_LIBS  "@PTM_SHARED_LABEL@"

// Embree, ALWAYS a dynamic library and therefore never covered by the
// executable's md5 -- and not inert: its SIMD kernels make different
// floating-point association choices, so grazing-incidence occlusion verdicts
// can flip between ISAs. Measured 2026-08-15 on an SSE2 -> multi-ISA swap of
// the identical Embree 4.3.3 source: Europa and Bennu byte-identical, a lunar
// polar DEM patch moved 75 of 260 output files, worst face-frame |dT|
// 0.0091 K. Recorded here so a results diff can be attributed rather than
// guessed at. "unknown" means Embree was located without its CMake package.
#define PTM_BUILD_EMBREE_LIB      "@PTM_EMBREE_LIB@"
#define PTM_BUILD_EMBREE_MAX_ISA  "@PTM_EMBREE_MAX_ISA@"

#endif  // PTM_BUILD_INFO_H
