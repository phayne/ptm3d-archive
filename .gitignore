# Generated data files
*.bin
*.fits
*.dat
output/
results/

# Flux-cube layouts and products. The layout is built from the placement and
# stored BESIDE THE TERRAIN MESH, so a run on a mesh that ships with the
# repository (data/meshes/) drops a generated binary into a tracked directory.
# It is reproducible from the placement it is named after and is never a
# source file.
*.fcg
*_flux_cubes_*.locations.csv
*.fcb

# Large data — dataset CONTENTS are ignored (distributed via
# scripts/fetch_data.py + data/data_manifest.json), but the per-dataset
# provenance README.md files are tracked (hence the ** / !**/ / !README.md
# triplets). data/kernels is handled by data/kernels/.gitignore; data/spice
# (1.6 MB mission SPKs) is tracked.
data/maps/*.fits
data/meshes/moon3d_cartesian_double.ply
data/emission/
# fetch_data.py keeps the verified tarballs it downloaded (~1.4 GB after
# --core) so that --verify can re-hash them without re-downloading. Every
# unpack DESTINATION is ignored below, but this cache was not, leaving it the
# one thing `git status` reports after a documented data fetch.
data/_downloads/
data/dem/**
!data/dem/**/
!data/dem/**/README.md
data/topo/**
!data/topo/**/
!data/topo/**/README.md
data/property_maps/**
!data/property_maps/**/
!data/property_maps/**/README.md
data/albedo_maps/**
!data/albedo_maps/**/
!data/albedo_maps/**/README.md
data/external/**
!data/external/**/
!data/external/**/README.md
data/jwst/

# Local caches and outputs
.cache/
camera_output/
plots/
notebooks/
# ...except the tracked, executed tutorial notebooks (docs/tutorials/notebooks/
# is a deliberate onboarding path, not a scratch dir the "notebooks/" rule above
# was written for -- unanchored pattern, so it silently matched this path too).
!docs/tutorials/notebooks/
!docs/tutorials/notebooks/**
examples/data/
docs/figures/jwst/

